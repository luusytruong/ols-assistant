{
  "name": "ols-assistant",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"pnpm --filter fe dev\" \"pnpm --filter be dev\"",
    "start": "concurrently \"pnpm --filter fe start\" \"pnpm --filter be start\"",
    "build": "concurrently \"pnpm --filter fe build\" \"pnpm --filter be build\""
  },
  "packageManager": "pnpm@10.28.1",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
